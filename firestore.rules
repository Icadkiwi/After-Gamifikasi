rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profil boleh dibuat segera setelah registrasi, sebelum email diverifikasi.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Learning/game data still use user-scoped local adapters.
      // Add explicit validated rules together with the future server adapter.
    }

    // Blokir semua akses lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
